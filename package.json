{
  "name": "vault",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:versions": "node scripts/check-runtime-versions.mjs",
    "test:release": "node scripts/test-v63-release-gate.mjs && node node_modules/typescript/bin/tsc --noEmit",
    "build": "npm run check:versions && node node_modules/next/dist/bin/next build",
    "build:export": "npm run check:versions && NEXT_PUBLIC_VAULT_NATIVE_RUNTIME=android CAPACITOR_BUILD=1 node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "cap:sync": "node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:android": "node node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:build": "npm run build:export && npm run cap:sync"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capgo/capacitor-native-biometric": "6.0.4",
    "@sentry/nextjs": "^8.0.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.3.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.417.0",
    "next": "14.2.5",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-datepicker": "^7.3.0",
    "react-dom": "^18.3.1",
    "sharp": "0.33.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "sharp": "0.33.4"
  }
}
